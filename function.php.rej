+function parseConfigs($input)
+{
+    $lines = explode("\n", $input);
+    $configs = [];
+
+    foreach ($lines as $line) {
+        $line = trim($line);
+        
+        if ($line === '') {
+            continue;
+        }
+
+        $randomChars = substr(str_shuffle("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"), 0, 6);
+        $autoName = 'Sub_' . $randomChars;
+
+        $configs[] = [
+            'name' => $autoName,
+            'config' => $line
+        ];
+    }
+
+    return $configs;
+}
